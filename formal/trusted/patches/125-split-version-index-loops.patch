+/// The index of the first `.` in `input` at or after `start`, or `input.len()` if there is none.
+fn dot_or_end(input: &[u8], start: usize) -> usize {
+    let mut i = start;
+    while i < input.len() {
+        if input[i] == b'.' {
+            return i;
+        }
+        i += 1;
+    }
+    input.len()
+}
+
+/// The index of the first byte of `input` that is not an ASCII digit, or `input.len()`.
+fn digits_end(input: &[u8]) -> usize {
+    let mut i = 0;
+    while i < input.len() {
+        if input[i] < b'0' || input[i] > b'9' {
+            return i;
+        }
+        i += 1;
+    }
+    input.len()
 }
 
