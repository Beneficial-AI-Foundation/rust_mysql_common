-                if let Some((date, time)) = date.zip(time) {
+                if let (Some(date), Some(time)) = (date, time) {
                     Ok(ParseIr(trusted::naive_datetime_new(date, time), v))
                 } else {
                     Err(FromValueError(v))
@@ -62,7 +62,7 @@ impl TryFrom<Value> for ParseIr<NaiveDateTime> {
                 {
                     let date = trusted::naive_date_from_ymd(year as i32, month, day);
                     let time = trusted::naive_time_from_hms_micro(hour, minute, second, micros);
-                    if let Some((date, time)) = date.zip(time) {
+                    if let (Some(date), Some(time)) = (date, time) {
                         Ok(ParseIr(trusted::naive_datetime_new(date, time), v))
                     } else {
                         Err(FromValueError(v))
