-            Value::Float(x) => match x.try_into() {
-                Ok(x) => Ok(ParseIr(x, v)),
-                Err(_) => Err(FromValueError(v)),
+            Value::Int(x) => Ok(ParseIr(trusted::bigdecimal_from_i64(x), v)),
+            Value::UInt(x) => Ok(ParseIr(trusted::bigdecimal_from_u64(x), v)),
+            Value::Float(x) => match trusted::bigdecimal_try_from_f32(x) {
+                Some(x) => Ok(ParseIr(x, v)),
+                None => Err(FromValueError(v)),
             },
-            Value::Double(x) => match x.try_into() {
-                Ok(x) => Ok(ParseIr(x, v)),
-                Err(_) => Err(FromValueError(v)),
+            Value::Double(x) => match trusted::bigdecimal_try_from_f64(x) {
+                Some(x) => Ok(ParseIr(x, v)),
+                None => Err(FromValueError(v)),
             },
-            Value::Bytes(ref bytes) => match BigDecimal::parse_bytes(bytes, 10) {
+            Value::Bytes(ref bytes) => match trusted::bigdecimal_parse_bytes(bytes) {
                 Some(x) => Ok(ParseIr(x, v)),
