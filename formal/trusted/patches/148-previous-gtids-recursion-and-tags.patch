+// ---- GTID tags (`packets::Tag`) ------------------------------------------------------------------
+//
+// `Tag` wraps a `Cow<str>`: its validation iterates over `str::chars`, and converting it to an
+// owned value goes through `ToOwned for str`; Aeneas models neither.
+
+/// `Tag::into_owned`.
+pub(crate) fn tag_into_owned(tag: crate::packets::Tag<'_>) -> crate::packets::Tag<'static> {
+    tag.into_owned()
+}
+
+/// `tag.as_str().as_bytes()`.
+pub(crate) fn tag_as_bytes<'a>(tag: &'a crate::packets::Tag<'_>) -> &'a [u8] {
+    tag.as_str().as_bytes()
+}
+
+/// The tag of a `PreviousGtidsEvent` SID entry: `std::str::from_utf8` then `Tag::new`, with the
+/// errors of `PreviousGtidsEvent::deserialize`.
+pub(crate) fn previous_gtids_tag(tag_bytes: &[u8]) -> io::Result<crate::packets::Tag<'_>> {
+    let tag_str = std::str::from_utf8(tag_bytes).map_err(|e| {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("invalid UTF-8 tag: {}", e),
+        )
+    })?;
+    crate::packets::Tag::new(tag_str).map_err(|e| {
+        io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("invalid GTID tag: {}", e),
+        )
+    })
+}
