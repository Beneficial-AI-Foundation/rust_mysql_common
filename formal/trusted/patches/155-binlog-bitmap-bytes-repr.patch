+
+/// `BareBytes<0x2000000000000000>` (the column bitmaps of binlog events), with the maximum
+/// length written as the associated constant `1 << 61` instead of a const generic argument.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub struct BareBitmapBytes;
+
+impl BytesRepr for BareBitmapBytes {
+    const MAX_LEN: usize = 1 << 61;
+    const SIZE: Option<usize> = None;
+    type Ctx = usize;
+
+    fn serialize(text: &[u8], buf: &mut Vec<u8>) {
+        let len = min(text.len(), Self::MAX_LEN);
+        buf.put_slice(&text[..len]);
+    }
+
+    fn deserialize<'de>(len: usize, buf: &mut ParseBuf<'de>) -> io::Result<Cow<'de, [u8]>> {
+        match buf.checked_eat(len) {
+            Some(x) => Ok(Cow::Borrowed(x)),
+            None => Err(unexpected_buf_eof()),
+        }
+    }
+}
