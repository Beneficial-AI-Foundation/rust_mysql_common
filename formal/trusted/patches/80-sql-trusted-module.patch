+//! Translation helpers: the trust boundary of the SQL-text code (`Value::as_sql`, `Params`).
+//!
+//! Every operation of `std` that has no Aeneas model and that `Value::as_sql` (formatting) or
+//! `Params` (`HashMap`) uses goes through exactly one function of this module, whose body is
+//! that one call. The module is `opaque` in Cargo.toml: these functions are not translated, and
+//! each has a Lean model or axiom in `formal/trusted/MysqlCommon/FunsExternal.lean`.
+//!
+//! `HashMap` iteration order: Rust seeds every map randomly (std `hash/random.rs`), while the
+//! Lean model makes the order a function of how the map was built, so specs must not relate the
+//! orders of separately built maps. The crate's results do not depend on the order.
+
+#![allow(dead_code)]
+
+use std::collections::HashMap;
+
+use crate::value::Value;
+
+// ---- String ------------------------------------------------------------------------------------
+
+/// `String::from(s)`.
+pub(crate) fn string_from_str(s: &str) -> String {
+    String::from(s)
+}
+
+/// `s.extend(t.chars())`.
+pub(crate) fn string_extend_chars(s: &mut String, t: String) {
+    s.extend(t.chars())
+}
+
+// ---- format! (one function per format string) -------------------------------------------------
+
+/// `format!("{}", x)`.
+pub(crate) fn format_i64(x: i64) -> String {
+    format!("{}", x)
+}
+
+/// `format!("{}", x)`.
+pub(crate) fn format_u64(x: u64) -> String {
+    format!("{}", x)
+}
+
+/// `format!("{}", x)`.
+pub(crate) fn format_f32(x: f32) -> String {
+    format!("{}", x)
+}
+
+/// `format!("{}", x)`.
+pub(crate) fn format_f64(x: f64) -> String {
+    format!("{}", x)
+}
+
+/// `format!("'{:04}-{:02}-{:02}'", y, m, d)`.
+pub(crate) fn format_date(y: u16, m: u8, d: u8) -> String {
+    format!("'{:04}-{:02}-{:02}'", y, m, d)
+}
+
+/// `format!("'{:04}-{:02}-{:02} {:02}:{:02}:{:02}'", year, month, day, hour, minute, second)`.
+pub(crate) fn format_datetime(
+    year: u16,
+    month: u8,
+    day: u8,
+    hour: u8,
+    minute: u8,
+    second: u8,
+) -> String {
+    format!(
+        "'{:04}-{:02}-{:02} {:02}:{:02}:{:02}'",
+        year, month, day, hour, minute, second
+    )
+}
+
+/// `format!("'{:04}-{:02}-{:02} {:02}:{:02}:{:02}.{:06}'", year, month, day, hour, minute,
+/// second, micros)`.
+pub(crate) fn format_datetime_micros(
+    year: u16,
+    month: u8,
+    day: u8,
+    hour: u8,
+    minute: u8,
+    second: u8,
+    micros: u32,
+) -> String {
+    format!(
+        "'{:04}-{:02}-{:02} {:02}:{:02}:{:02}.{:06}'",
+        year, month, day, hour, minute, second, micros
+    )
+}
+
+/// `format!("'-{:03}:{:02}:{:02}'", hours, i, s)`.
+pub(crate) fn format_time_neg(hours: u32, i: u8, s: u8) -> String {
+    format!("'-{:03}:{:02}:{:02}'", hours, i, s)
+}
+
+/// `format!("'{:03}:{:02}:{:02}'", hours, i, s)`.
+pub(crate) fn format_time(hours: u32, i: u8, s: u8) -> String {
+    format!("'{:03}:{:02}:{:02}'", hours, i, s)
+}
+
+/// `format!("'-{:03}:{:02}:{:02}.{:06}'", hours, minutes, seconds, micros)`.
+pub(crate) fn format_time_micros_neg(hours: u32, minutes: u8, seconds: u8, micros: u32) -> String {
+    format!(
+        "'-{:03}:{:02}:{:02}.{:06}'",
+        hours, minutes, seconds, micros
+    )
+}
+
+/// `format!("'{:03}:{:02}:{:02}.{:06}'", hours, minutes, seconds, micros)`.
+pub(crate) fn format_time_micros(hours: u32, minutes: u8, seconds: u8, micros: u32) -> String {
+    format!("'{:03}:{:02}:{:02}.{:06}'", hours, minutes, seconds, micros)
+}
+
+/// `format!("{:02X}", c)`.
+pub(crate) fn format_hex_upper_02(c: u8) -> String {
+    format!("{:02X}", c)
+}
+
+// ---- HashMap<Vec<u8>, Value> (the map of `Params::Named`) -------------------------------------
+
+/// `HashMap::default()`.
+pub(crate) fn params_map_new() -> HashMap<Vec<u8>, Value> {
+    HashMap::default()
+}
+
+/// `map.contains_key(key)`.
+pub(crate) fn params_map_contains_key(map: &HashMap<Vec<u8>, Value>, key: &[u8]) -> bool {
+    map.contains_key(key)
+}
+
+/// `map.insert(key, value)`.
+pub(crate) fn params_map_insert(
+    map: &mut HashMap<Vec<u8>, Value>,
+    key: Vec<u8>,
+    value: Value,
+) -> Option<Value> {
+    map.insert(key, value)
+}
+
+/// `map.get(key)`.
+pub(crate) fn params_map_get<'a>(
+    map: &'a HashMap<Vec<u8>, Value>,
+    key: &[u8],
+) -> Option<&'a Value> {
+    map.get(key)
+}
+
+/// `map.remove(key)`.
+pub(crate) fn params_map_remove(map: &mut HashMap<Vec<u8>, Value>, key: &[u8]) -> Option<Value> {
+    map.remove(key)
+}
+
+/// `map.into_iter().collect()`: the entries, in the map's iteration order.
+pub(crate) fn params_map_into_entries(map: HashMap<Vec<u8>, Value>) -> Vec<(Vec<u8>, Value)> {
+    map.into_iter().collect()
+}
