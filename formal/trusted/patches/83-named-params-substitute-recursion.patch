+/// The tail of `ParsedNamedParams::parse`: for each `params[k..]`, appends the query up to its
+/// colon and a `?` to `real_query` and its name to `out_params`, then appends the rest of the
+/// query (`last` is the end of the previous parameter).
+fn substitute_params<'a>(
+    query: &'a [u8],
+    params: &[(usize, usize, usize)],
+    k: usize,
+    last: usize,
+    mut real_query: Vec<u8>,
+    mut out_params: Vec<Cow<'a, [u8]>>,
+) -> (Vec<u8>, Vec<Cow<'a, [u8]>>) {
+    if k < params.len() {
+        let (colon_offset, start, end) = params[k];
+        real_query.extend_from_slice(&query[last..colon_offset]);
+        real_query.push(b'?');
+        out_params.push(Cow::Borrowed(&query[start..end]));
+        substitute_params(query, params, k + 1, end, real_query, out_params)
+    } else {
+        real_query.extend_from_slice(&query[last..]);
+        (real_query, out_params)
+    }
+}
