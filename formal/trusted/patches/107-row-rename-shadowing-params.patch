-    fn from_row_opt(row: Row) -> Result<Self, FromRowError>
+    fn from_row_opt(r: Row) -> Result<Self, FromRowError>
     where
         Self: Sized,
     {
-        if !row.is_empty() {
-            return Err(FromRowError(row));
+        if !r.is_empty() {
+            return Err(FromRowError(r));
         }
