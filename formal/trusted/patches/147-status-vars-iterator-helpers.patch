+/// `iter.find_map(|var| if var.key == needle { Some(var) } else { None })`.
+fn find_status_var<'a>(
+    iter: &mut StatusVarsIterator<'a>,
+    needle: StatusVarKey,
+) -> Option<StatusVar<'a>> {
+    match iter.next() {
+        Some(var) => {
+            if var.key == needle {
+                Some(var)
+            } else {
+                find_status_var(iter, needle)
+            }
+        }
+        None => None,
+    }
+}
