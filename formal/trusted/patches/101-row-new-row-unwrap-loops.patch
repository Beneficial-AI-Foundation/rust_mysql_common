+/// `values.into_iter().map(Some).collect::<Vec<_>>()` of `new_row`, as an index loop.
+fn values_to_cells(mut values: Vec<Value>) -> Vec<Option<Value>> {
+    let mut cells = Vec::with_capacity(values.len());
+    let mut i = 0;
+    while i < values.len() {
+        cells.push(Some(std::mem::replace(&mut values[i], Value::NULL)));
+        i += 1;
+    }
+    cells
+}
