+// `row.iter().map(StmtBulkExecuteParamType::from_value).collect::<Vec<_>>()`.
+fn bulk_param_types(row: &[Value]) -> Vec<StmtBulkExecuteParamType> {
+    let mut types = Vec::with_capacity(row.len());
+    for i in 0..row.len() {
+        types.push(StmtBulkExecuteParamType::from_value(&row[i]));
+    }
+    types
+}
+
+// The loop `for (left, right) in types.iter_mut().zip(row_types)` of
+// `ComStmtBulkExecuteRequest::new`.
+fn merge_bulk_param_types(
+    types: &mut [StmtBulkExecuteParamType],
+    row_types: &[StmtBulkExecuteParamType],
+) {
+    let n = if types.len() < row_types.len() {
+        types.len()
+    } else {
+        row_types.len()
+    };
+    for i in 0..n {
+        let left = types[i];
+        let right = row_types[i];
+        if left.column_type() != right.column_type() || left.flags() != right.flags() {
+            if left.column_type() == ColumnType::MYSQL_TYPE_NULL {
+                types[i] = right;
+            } else if left.column_type() == right.column_type() {
+                types[i] = StmtBulkExecuteParamType::new(
+                    right.column_type(),
+                    // if flag is required by a single param value,
+                    // then it must be given for the whole batch
+                    left.flags().union(right.flags()),
+                )
+            } else {
+                // TODO: Values of different types are given for the same parameter
+                //       within the batch. Not sure if server will always error here.
+                // The error:
+                //   ERROR 1210 (HY000): Incorrect arguments to mysqld_stmt_bulk_execute
+            }
+        }
+    }
+}
+
+// `values.into_iter().flatten().map(StmtBulkExecuteParamValue::new).collect()`, moving each value
+// out of `values` (leaving `Value::NULL` behind).
+fn take_bulk_param_values(values: &mut [Vec<Value>]) -> Vec<StmtBulkExecuteParamValue> {
+    let mut out = Vec::new();
+    for i in 0..values.len() {
+        take_bulk_param_row(&mut values[i], &mut out);
+    }
+    out
+}
+
+// The inner loop of `take_bulk_param_values`.
+fn take_bulk_param_row(row: &mut [Value], out: &mut Vec<StmtBulkExecuteParamValue>) {
+    for j in 0..row.len() {
+        out.push(StmtBulkExecuteParamValue::new(mem::replace(
+            &mut row[j],
+            Value::NULL,
+        )));
+    }
+}
