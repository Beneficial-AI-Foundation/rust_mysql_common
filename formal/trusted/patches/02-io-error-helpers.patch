+/// `io::Error::new(kind, msg)` for a static message. (Translation helper: kept opaque, since
+/// constructing an `io::Error` goes through `Box<dyn Error>`.)
+pub(crate) fn io_error_msg(kind: io::ErrorKind, msg: &'static str) -> io::Error {
+    io::Error::new(kind, msg)
+}
+
+/// `io::Error::new(kind, err)` for an error value. (Translation helper: kept opaque, since
+/// constructing an `io::Error` goes through `Box<dyn Error>`.)
+pub(crate) fn io_error_from<E>(kind: io::ErrorKind, err: E) -> io::Error
+where
+    E: std::error::Error + Send + Sync + 'static,
+{
+    io::Error::new(kind, err)
+}
+
 pub(crate) fn unexpected_buf_eof() -> io::Error {
-    io::Error::new(
+    io_error_msg(
         io::ErrorKind::UnexpectedEof,
         "can't parse: buf doesn't have enough data",
     )
