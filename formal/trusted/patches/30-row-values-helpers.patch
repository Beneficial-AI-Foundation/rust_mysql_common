+/// The loop `for i in 0..columns.len() { .. }` of `MyDeserialize for RowDeserializer<S, Binary>`,
+/// written as a recursion on `i`: pushes the values of the columns `i..` to `values`.
+fn deserialize_bin_values<'de, S: SerializationSide>(
+    columns: &[Column],
+    bitmap: &NullBitmap<S, Cow<'de, [u8]>>,
+    buf: &mut ParseBuf<'de>,
+    i: usize,
+    mut values: Vec<Option<Value>>,
+) -> io::Result<Vec<Option<Value>>> {
+    use Value::*;
+
+    if i < columns.len() {
+        let column = &columns[i];
+        if bitmap.is_null(i) {
+            values.push(Some(NULL));
+            deserialize_bin_values(columns, bitmap, buf, i + 1, values)
+        } else {
+            values.push(Some(
+                ValueDeserializer::<BinValue>::deserialize(
+                    (column.column_type(), column.flags()),
+                    &mut *buf,
+                )?
+                .0,
+            ));
+            deserialize_bin_values(columns, bitmap, buf, i + 1, values)
+        }
+    } else {
+        Ok(values)
+    }
+}
