+/// The loop of `MyDeserialize for RowDeserializer<T, Text>`: `num_columns` text values.
+fn deserialize_text_values(
+    num_columns: usize,
+    buf: &mut ParseBuf<'_>,
+) -> io::Result<Vec<Option<Value>>> {
+    let mut values = Vec::with_capacity(num_columns);
+
+    for _ in 0..num_columns {
+        values.push(Some(
+            ValueDeserializer::<TextValue>::deserialize((), &mut *buf)?.0,
+        ))
+    }
+
