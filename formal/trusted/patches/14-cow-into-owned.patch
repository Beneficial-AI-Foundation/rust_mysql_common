 //! Various parsing/serialization primitives.
 
-use std::io;
+use std::{borrow::Cow, io};
 
 use crate::io::BufMut;
 
@@ -33,6 +33,14 @@ pub mod flags;
 pub mod int;
 pub mod seq;
 
+/// `cow.into_owned()`, written as a `match`.
+pub(crate) fn cow_into_vec<T: Clone>(cow: Cow<'_, [T]>) -> Vec<T> {
+    match cow {
+        Cow::Borrowed(s) => s.to_vec(),
+        Cow::Owned(v) => v,
+    }
+}
