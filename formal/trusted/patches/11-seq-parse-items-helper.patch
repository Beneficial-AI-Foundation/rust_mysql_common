+/// Pushes `len` values of `T` parsed from `buf` onto `seq`, and returns it as an owned sequence.
+fn parse_items<'de, T>(
+    len: usize,
+    buf: &mut ParseBuf<'de>,
+    mut seq: Vec<T>,
+) -> io::Result<Cow<'de, [T]>>
+where
+    T: Clone,
+    T: MyDeserialize<'de, Ctx = ()>,
+{
+    for _ in 0..len {
+        seq.push(buf.parse(())?);
+    }
+    Ok(Cow::Owned(seq))
+}
+
 /// Representation of a serialized bytes.
 pub trait SeqRepr {
     /// Maximum number of items in a sequence (depends on how lenght is stored).
@@ -140,21 +156,14 @@ impl SeqRepr for Unknown {
