     {
-        let mut seq = Vec::with_capacity(len);
+        let seq = Vec::with_capacity(len);
         match T::SIZE {
             Some(count) => {
                 let mut buf: ParseBuf<'_> = buf.parse(count * len)?;
-                for _ in 0..len {
-                    seq.push(buf.parse(())?);
-                }
-            }
-            None => {
-                for _ in 0..len {
-                    seq.push(buf.parse(())?);
-                }
+                parse_items(len, &mut buf, seq)
             }
+            None => parse_items(len, buf, seq),
         }
-        Ok(Cow::Owned(seq))
     }
 }
 
