def binlog.events.previous_gtids_event.serialize_sid_tag
  (tag : Option packets.Tag) (tagged : Bool) (buf : alloc.vec.Vec Std.U8) :
  Result (alloc.vec.Vec Std.U8)
  := do
  if tagged
  then
    match tag with
    | none => misc.write_varlen_uint buf 0#u64
    | some t =>
      let tag_bytes ← binlog.trusted.tag_as_bytes t
      let i := Slice.len tag_bytes
      let i1 ← lift (UScalar.cast .U64 i)
      let buf1 ← misc.write_varlen_uint buf i1
      alloc.vec.Vec.extend_from_slice core.clone.CloneU8 buf1 tag_bytes
  else ok buf

