        let i3 ← i1 + i2
        sql_trusted.format_time_micros_neg i3 i s micros
      else
        let i1 ← d * 24#u32
        let i2 ← lift (UScalar.cast .U32 h)
        let i3 ← i1 + i2
        sql_trusted.format_time_micros i3 i s micros

end mysql_common
