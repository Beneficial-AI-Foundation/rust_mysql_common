/-- [mysql_common::misc::write_varlen_uint]:
    Source: 'src/misc/mod.rs', lines 102:0-120:1
    Visibility: public -/
def misc.write_varlen_uint
  (buf : alloc.vec.Vec Std.U8) (value : Std.U64) :
  Result (alloc.vec.Vec Std.U8)
  := do
  let num_bytes ← misc.varlen_uint_size value
  if num_bytes = 9#usize
  then
    let buf1 ← alloc.vec.Vec.push buf 255#u8
    let a ← lift (core.num.U64.to_le_bytes value)
    let s ← lift (Array.to_slice a)
    alloc.vec.Vec.extend_from_slice core.clone.CloneU8 buf1 s
  else
    let shifted ← value <<< num_bytes
    let i ← num_bytes - 1#usize
    let i1 ← 1#u64 <<< i
    let trailer ← i1 - 1#u64
    let encoded ← lift (shifted ||| trailer)
    let a ← lift (core.num.U64.to_le_bytes encoded)
    let s ←
      core.array.Array.index (core.ops.index.IndexSlice
        (core.slice.index.SliceIndexRangeToUsizeSlice Std.U8)) a
        { «end» := num_bytes }
    alloc.vec.Vec.extend_from_slice core.clone.CloneU8 buf s

