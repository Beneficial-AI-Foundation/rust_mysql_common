+//! Translation helpers: the trust boundary of the packets (`src/packets/`).
+//!
+//! Every operation of a dependency crate (or of `std`, where Aeneas has no model) that the
+//! packets use goes through exactly one function of this module, whose body is that one call.
+//! The module is `opaque` in Cargo.toml: these functions are not translated, and each has a Lean
+//! model or axiom in `lean/MysqlCommon/FunsExternal.lean`.
+
+#![allow(dead_code)]
+
+use std::{borrow::Cow, sync::LazyLock};
+
+use regex::bytes::Regex;
+
+// ---- std ---------------------------------------------------------------------------------------
+
+/// `String::from_utf8_lossy(bytes)`.
+pub(crate) fn from_utf8_lossy(bytes: &[u8]) -> Cow<'_, str> {
+    String::from_utf8_lossy(bytes)
+}
+
+// ---- regex + btoi ------------------------------------------------------------------------------
+
+// Copied verbatim from `src/packets/mod.rs`.
+static MARIADB_VERSION_RE: LazyLock<Regex> = LazyLock::new(|| {
+    Regex::new(r"^(?:5.5.5-)?(\d{1,2})\.(\d{1,2})\.(\d{1,3})(?:-\d+)?-MariaDB").unwrap()
+});
+static VERSION_RE: LazyLock<Regex> =
+    LazyLock::new(|| Regex::new(r"^(\d{1,2})\.(\d{1,2})\.(\d{1,3})(.*)").unwrap());
+
+/// `VERSION_RE.captures(bytes)`, with the bytes of capture groups 1, 2 and 3 (which take part in
+/// every match, so `get(i).unwrap()` cannot panic).
+pub(crate) fn version_re_captures(bytes: &[u8]) -> Option<(&[u8], &[u8], &[u8])> {
+    match VERSION_RE.captures(bytes) {
+        Some(captures) => Some((
+            captures.get(1).unwrap().as_bytes(),
+            captures.get(2).unwrap().as_bytes(),
+            captures.get(3).unwrap().as_bytes(),
+        )),
+        None => None,
+    }
+}
+
+/// `MARIADB_VERSION_RE.captures(bytes)`, with the bytes of capture groups 1, 2 and 3 (which take
+/// part in every match, so `get(i).unwrap()` cannot panic).
+pub(crate) fn mariadb_version_re_captures(bytes: &[u8]) -> Option<(&[u8], &[u8], &[u8])> {
+    match MARIADB_VERSION_RE.captures(bytes) {
+        Some(captures) => Some((
+            captures.get(1).unwrap().as_bytes(),
+            captures.get(2).unwrap().as_bytes(),
+            captures.get(3).unwrap().as_bytes(),
+        )),
+        None => None,
+    }
+}
+
+/// `btoi::btoi::<u16>(bytes).ok()`.
+pub(crate) fn btoi_u16(bytes: &[u8]) -> Option<u16> {
+    btoi::btoi::<u16>(bytes).ok()
+}
