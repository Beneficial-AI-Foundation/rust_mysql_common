+//! Translation model (not part of upstream `mysql_common`): the buffer operations that the plain
+//! codec uses, as crate-local traits, with
+//!
+//! * delegating implementations for the `bytes` types (`Buf`, `BufMut`, `BytesMut`), which is
+//!   what the crate itself instantiates the codec with, and
+//! * a `Vec<u8>`-backed model type [`VecBuf`] whose methods have the semantics of the
+//!   corresponding `BytesMut` methods.
+//!
+//! Also a crate-local `NonZeroUsize` with the API of `std::num::NonZeroUsize` that the codec uses.
+
+use std::{fmt, ops::Deref};
+
+use bytes::BytesMut;
+
+/// `std::num::NonZeroUsize` (the subset the codec uses): a `usize` that is not `0`.
+#[derive(Clone, Copy, Eq, PartialEq, Ord, PartialOrd, Hash)]
+pub struct NonZeroUsize(usize);
+
+#[verify::start_from]
+impl NonZeroUsize {
+    /// `NonZeroUsize::new`: `Some` iff `n != 0`.
+    #[inline]
+    pub const fn new(n: usize) -> Option<Self> {
+        if n != 0 { Some(Self(n)) } else { None }
+    }
+
+    /// `NonZeroUsize::get`.
+    #[inline]
+    pub const fn get(self) -> usize {
+        self.0
+    }
+}
+
+impl fmt::Debug for NonZeroUsize {
+    /// `NonZeroUsize` is formatted as its value.
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        fmt::Debug::fmt(&self.0, f)
+    }
+}
+
+/// The methods of `bytes::Buf` that the codec uses.
+pub trait PacketBuf {
+    /// `Buf::remaining`.
+    fn remaining(&self) -> usize;
+    /// `Buf::chunk`.
+    fn chunk(&self) -> &[u8];
+    /// `Buf::advance`.
+    fn advance(&mut self, cnt: usize);
+    /// `Buf::has_remaining` (the default body of `bytes`).
+    fn has_remaining(&self) -> bool {
+        self.remaining() > 0
+    }
+}
+
+impl<T: bytes::Buf + ?Sized> PacketBuf for T {
+    fn remaining(&self) -> usize {
+        bytes::Buf::remaining(self)
+    }
+    fn chunk(&self) -> &[u8] {
+        bytes::Buf::chunk(self)
+    }
+    fn advance(&mut self, cnt: usize) {
+        bytes::Buf::advance(self, cnt)
+    }
+    fn has_remaining(&self) -> bool {
+        bytes::Buf::has_remaining(self)
+    }
+}
+
+/// The methods of `bytes::BufMut` that the codec uses.
+pub trait PacketBufMut {
+    /// `BufMut::put_slice`.
+    fn put_slice(&mut self, src: &[u8]);
+    /// `BufMut::put_u32_le` (the default body of `bytes`).
+    fn put_u32_le(&mut self, n: u32) {
+        self.put_slice(&n.to_le_bytes())
+    }
+}
+
+impl<T: bytes::BufMut + ?Sized> PacketBufMut for T {
+    fn put_slice(&mut self, src: &[u8]) {
+        bytes::BufMut::put_slice(self, src)
+    }
+    fn put_u32_le(&mut self, n: u32) {
+        bytes::BufMut::put_u32_le(self, n)
+    }
+}
+
+/// `BytesMut::reserve`.
+pub trait Reserve {
+    /// Reserves capacity for at least `additional` more bytes (no other effect).
+    fn reserve(&mut self, additional: usize);
+}
+
+impl Reserve for BytesMut {
+    fn reserve(&mut self, additional: usize) {
+        BytesMut::reserve(self, additional)
+    }
+}
+
+/// A `Vec<u8>`-backed model of `BytesMut`: the bytes of the buffer are `self.0`.
+///
+/// Each method has the semantics of the `BytesMut` method of the same name on the buffer's
+/// bytes; capacity is not modelled.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct VecBuf(pub Vec<u8>);
+
+#[verify::start_from]
+impl Deref for VecBuf {
+    type Target = [u8];
+
+    /// `BytesMut::deref`: the bytes of the buffer.
+    fn deref(&self) -> &[u8] {
+        &self.0
+    }
+}
+
+#[verify::start_from]
+impl AsRef<[u8]> for VecBuf {
+    /// `BytesMut::as_ref`: the bytes of the buffer.
+    fn as_ref(&self) -> &[u8] {
+        &self.0
+    }
+}
+
+#[verify::start_from]
+impl PacketBuf for VecBuf {
+    /// `Buf for BytesMut::remaining`: the length of the buffer.
+    fn remaining(&self) -> usize {
+        self.0.len()
+    }
+
+    /// `Buf for BytesMut::chunk`: all bytes of the buffer.
+    fn chunk(&self) -> &[u8] {
+        &self.0
+    }
+
+    /// `Buf for BytesMut::advance`: drops the first `cnt` bytes; panics if `cnt > len`.
+    fn advance(&mut self, cnt: usize) {
+        let rest = self.0[cnt..].to_vec();
+        self.0 = rest;
+    }
+}
+
+#[verify::start_from]
+impl PacketBufMut for VecBuf {
+    /// `BufMut for BytesMut::put_slice`: appends `src`.
+    fn put_slice(&mut self, src: &[u8]) {
+        self.0.extend_from_slice(src);
+    }
+}
+
+#[verify::start_from]
+impl Reserve for VecBuf {
+    /// `BytesMut::reserve` only changes the capacity.
+    fn reserve(&mut self, _additional: usize) {}
+}
