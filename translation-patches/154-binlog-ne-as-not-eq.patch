Translation patch: `!=` on derived `PartialEq` types in the binlog helpers

Change: In `LogicalClockFields::serialize_untagged`/`len_untagged` (`RawInt` fields), `event_len` (`BinlogChecksumAlg`) and `serialize_uncompressed_size` (`TransactionPayloadCompressionType`), `a != b` becomes `!(a == b)`.
Why: A call of `PartialEq::ne` makes Aeneas add the provided method `ne` to every `PartialEq` instance of the translation, which changes the existing translated instances; with `==` the existing translation is unchanged.
Behaviour: Identical: these types derive `PartialEq`, which does not override `ne`, whose default is `!self.eq(other)`.

diff --git a/src/binlog/events/gtid_event.rs b/src/binlog/events/gtid_event.rs
index abd71cf..a68c865 100644
--- a/src/binlog/events/gtid_event.rs
+++ b/src/binlog/events/gtid_event.rs
@@ -886,28 +886,28 @@ impl LogicalClockFields {
         self.sequence_number.serialize(&mut *buf);
 
         let mut immediate_commit_timestamp_with_flag = *self.immediate_commit_timestamp;
-        if self.immediate_commit_timestamp != self.original_commit_timestamp {
+        if !(self.immediate_commit_timestamp == self.original_commit_timestamp) {
             immediate_commit_timestamp_with_flag |= 1 << 55;
         } else {
             immediate_commit_timestamp_with_flag &= !(1 << 55);
         }
         RawInt::<LeU56>::new(immediate_commit_timestamp_with_flag).serialize(&mut *buf);
 
-        if self.immediate_commit_timestamp != self.original_commit_timestamp {
+        if !(self.immediate_commit_timestamp == self.original_commit_timestamp) {
             self.original_commit_timestamp.serialize(&mut *buf);
         }
 
         self.tx_length.serialize(&mut *buf);
 
         let mut immediate_server_version_with_flag = *self.immediate_server_version;
-        if self.immediate_server_version != self.original_server_version {
+        if !(self.immediate_server_version == self.original_server_version) {
             immediate_server_version_with_flag |= 1 << 31;
         } else {
             immediate_server_version_with_flag &= !(1 << 31);
         }
         RawInt::<LeU32>::new(immediate_server_version_with_flag).serialize(&mut *buf);
 
-        if self.immediate_server_version != self.original_server_version {
+        if !(self.immediate_server_version == self.original_server_version) {
             self.original_server_version.serialize(&mut *buf);
         }
     }
@@ -925,13 +925,13 @@ impl LogicalClockFields {
         len = len.saturating_add(8); // sequence_number
 
         len = len.saturating_add(7); // immediate_commit_timestamp
-        if self.immediate_commit_timestamp != self.original_commit_timestamp {
+        if !(self.immediate_commit_timestamp == self.original_commit_timestamp) {
             len = len.saturating_add(7); // original_commit_timestamp
         }
 
         len = len.saturating_add(crate::misc::lenenc_int_len(*self.tx_length) as usize); // tx_length
         len = len.saturating_add(4); // immediate_server_version
-        if self.immediate_server_version != self.original_server_version {
+        if !(self.immediate_server_version == self.original_server_version) {
             len = len.saturating_add(4); // original_server_version
         }
 
