+/// Same as `my_bitflags!`, but the flags type is a plain `struct $Name($T)` with the API that
+/// `bitflags::bitflags!` (2.x) generates, written out with the same bodies (`bitflags`
+/// `src/public.rs`, `src/internal.rs`, `src/traits.rs`). The `derive` list of the type must not
+/// contain `Debug`: the `Debug` impl generated here is the one of `bitflags`.
+macro_rules! my_plain_bitflags {
+    (
+        $name:ident, $(#[$em:meta])+ $err:ident, $ty:path,
+        $(#[$outer:meta])*
+        $vis:vis struct $Name:ident: $T:ty {
+            $(
+                $(#[$inner:meta])*
+                const $Flag:ident = $value:expr;
+            )*
+        }
+    ) => {
+        #[derive(Debug, Clone, Copy, Eq, PartialEq, Hash, thiserror::Error)]
+        $(#[$em])+
+        pub struct $err(pub $ty);
+
+        impl TryFrom<$ty> for $name {
+            type Error = $err;
+
+            fn try_from(val: $ty) -> std::result::Result<$name, $err> {
+                match $name::from_bits(val) {
+                    Some(flags) => Ok(flags),
+                    None => Err($err(val)),
+                }
+            }
+        }
+
+        impl From<$name> for $ty {
+            fn from(val: $name) -> $ty {
+                val.bits()
+            }
+        }
+
+        impl Default for $name {
+            fn default() -> $name {
+                $name::empty()
+            }
+        }
+
+        $(#[$outer])*
+        #[repr(transparent)]
+        $vis struct $Name($T);
+
+        #[allow(dead_code)]
+        impl $Name {
+            $(
+                $(#[$inner])*
+                pub const $Flag: Self = Self($value);
+            )*
+
+            /// Get a flags value with all bits unset.
+            #[inline]
+            pub const fn empty() -> Self {
+                Self(0)
+            }
+
+            /// Get a flags value with all known bits set.
+            #[inline]
+            pub const fn all() -> Self {
+                Self(0 $(| $value)*)
+            }
+
+            /// Get the underlying bits value.
+            #[inline]
+            pub const fn bits(&self) -> $T {
+                self.0
+            }
+
+            /// Convert from a bits value, unless any unset bits are set.
+            #[inline]
+            pub const fn from_bits(bits: $T) -> Option<Self> {
+                let truncated = Self::from_bits_truncate(bits).0;
+                if truncated == bits {
+                    Some(Self(bits))
+                } else {
+                    None
+                }
+            }
+
+            /// Convert from a bits value, unsetting any unknown bits.
+            #[inline]
+            pub const fn from_bits_truncate(bits: $T) -> Self {
+                Self(bits & Self::all().0)
+            }
+
+            /// Convert from a bits value exactly.
+            #[inline]
+            pub const fn from_bits_retain(bits: $T) -> Self {
+                Self(bits)
+            }
+
+            /// Whether all bits in this flags value are unset.
+            #[inline]
+            pub const fn is_empty(&self) -> bool {
+                self.0 == 0
+            }
+
+            /// Whether all known bits in this flags value are set.
+            #[inline]
+            pub const fn is_all(&self) -> bool {
+                Self::all().0 | self.0 == self.0
+            }
+
+            /// Whether any set bits in a source flags value are also set in a target flags value.
+            #[inline]
+            pub const fn intersects(&self, other: Self) -> bool {
+                self.0 & other.0 != 0
+            }
+
+            /// Whether all set bits in a source flags value are also set in a target flags value.
+            #[inline]
+            pub const fn contains(&self, other: Self) -> bool {
+                self.0 & other.0 == other.0
+            }
+
+            /// The bitwise or (`|`) of the bits in two flags values.
+            #[inline]
+            pub fn insert(&mut self, other: Self) {
