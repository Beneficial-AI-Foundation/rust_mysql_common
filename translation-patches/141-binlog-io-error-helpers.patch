 use std::io;
 
+// ---- std ---------------------------------------------------------------------------------------
+
+/// The error of `Event::read_event` when the event data is not fully consumed:
+/// `io::Error::other(format!("bytes remaining on stream while reading {}", type_name::<T>()))`.
+pub(crate) fn bytes_remaining_error<T>() -> io::Error {
+    io::Error::other(format!(
+        "bytes remaining on stream while reading {}",
+        std::any::type_name::<T>()
+    ))
+}
