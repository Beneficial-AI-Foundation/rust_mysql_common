+// ---- btoi --------------------------------------------------------------------------------------
+
+macro_rules! btoi_helpers {
+    ($($name:ident: $ty:ty),* $(,)?) => {
+        $(
+            #[doc = concat!("`btoi::btoi::<", stringify!($ty), ">(bytes).ok()`.")]
+            pub(crate) fn $name(bytes: &[u8]) -> Option<$ty> {
+                btoi::btoi::<$ty>(bytes).ok()
+            }
+        )*
+    };
+}
+
+btoi_helpers!(
+    btoi_i8: i8,
+    btoi_u8: u8,
+    btoi_i16: i16,
+    btoi_u16: u16,
+    btoi_i32: i32,
+    btoi_u32: u32,
+    btoi_i64: i64,
+    btoi_u64: u64,
+    btoi_isize: isize,
+    btoi_usize: usize,
+    btoi_i128: i128,
+    btoi_u128: u128,
+);
+
