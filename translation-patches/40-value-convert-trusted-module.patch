+//! Translation helpers: the trust boundary of the value conversions.
+//!
+//! Every operation of a dependency crate (or of `std`, where Aeneas has no model) that the value
+//! conversions use goes through exactly one function of this module, whose body is that one call.
+//! The module is `opaque` in Cargo.toml: these functions are not translated, and each has a Lean
+//! model or axiom in `lean/MysqlCommon/FunsExternal.lean`.
+
+#![allow(dead_code)]
+
+use std::{sync::LazyLock, time::Duration};
+
+use regex::bytes::Regex;
+
+// ---- std ---------------------------------------------------------------------------------------
+
+/// `std::str::from_utf8(bytes).ok()`.
+pub(crate) fn str_from_utf8(bytes: &[u8]) -> Option<&str> {
+    std::str::from_utf8(bytes).ok()
+}
+
+/// `String::from_utf8(bytes)`, with the error's `into_bytes()` (the original vector).
+pub(crate) fn string_from_utf8(bytes: Vec<u8>) -> Result<String, Vec<u8>> {
+    match String::from_utf8(bytes) {
+        Ok(x) => Ok(x),
+        Err(e) => Err(e.into_bytes()),
+    }
+}
+
+/// `String::into_bytes`.
+pub(crate) fn string_into_bytes(s: String) -> Vec<u8> {
+    s.into_bytes()
+}
+
+/// `str::as_bytes`.
+pub(crate) fn str_as_bytes(s: &str) -> &[u8] {
+    s.as_bytes()
+}
+
+/// `s.parse::<f32>().ok()`.
+pub(crate) fn str_parse_f32(s: &str) -> Option<f32> {
+    s.parse::<f32>().ok()
+}
+
+/// `s.parse::<f64>().ok()`.
+pub(crate) fn str_parse_f64(s: &str) -> Option<f64> {
+    s.parse::<f64>().ok()
+}
+
+/// `f64::from(x)`.
+pub(crate) fn f32_to_f64(x: f32) -> f64 {
+    f64::from(x)
+}
+
+/// `x.to_string()`.
+pub(crate) fn i128_to_string(x: i128) -> String {
+    x.to_string()
+}
+
+/// `x.to_string()`.
