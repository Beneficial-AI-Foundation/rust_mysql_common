+//! Translation helpers: the trust boundary of the binlog code.
+//!
+//! Every operation of a dependency crate that the binlog code uses goes through exactly one
+//! function (or type) of this module, whose body is that one call. The module is `opaque` in
+//! Cargo.toml: it is not translated, and each function has a Lean model or axiom in
+//! `lean/MysqlCommon/FunsExternal.lean`.
+
+#![allow(dead_code, unused_variables)]
+
+use std::io;
+
+// ---- zstd --------------------------------------------------------------------------------------
+//
+// `zstd` is a C library (`zstd-sys`), which does not cross-compile to the translation target. It
+// is enabled by the `binlog` feature; the translated configuration enables only `binlog_core`
+// (the binlog code without `zstd`), under which these helpers are stubs that fail. Only the
+// `TransactionPayloadEvent` decompression API reaches them, and that API is not translated.
+
+/// A buffered zstd decoder over a byte slice: `BufReader<zstd::Decoder<'a, &'a [u8]>>`.
+#[cfg(feature = "binlog")]
+pub(crate) struct ZstdReader<'a>(io::BufReader<zstd::Decoder<'a, &'a [u8]>>);
+
+/// Without `zstd`, a zstd reader is never constructed.
+#[cfg(not(feature = "binlog"))]
+pub(crate) struct ZstdReader<'a>(
+    std::convert::Infallible,
+    std::marker::PhantomData<&'a [u8]>,
+);
+
+/// `BufReader::new(zstd::Decoder::with_buffer(data)?)`.
+#[cfg(feature = "binlog")]
+pub(crate) fn zstd_reader_new(data: &[u8]) -> io::Result<ZstdReader<'_>> {
+    let decoder = zstd::Decoder::with_buffer(data)?;
+    Ok(ZstdReader(io::BufReader::new(decoder)))
+}
+
+/// Without `zstd`: always an error.
+#[cfg(not(feature = "binlog"))]
+pub(crate) fn zstd_reader_new(_data: &[u8]) -> io::Result<ZstdReader<'_>> {
+    Err(io::Error::other("zstd support is not compiled in"))
+}
+
+/// `zstd::stream::copy_decode(src, dst)`.
+#[cfg(feature = "binlog")]
+pub(crate) fn zstd_copy_decode(src: &[u8], dst: &mut [u8]) -> io::Result<()> {
+    zstd::stream::copy_decode(src, dst)
+}
+
+/// Without `zstd`: always an error.
+#[cfg(not(feature = "binlog"))]
+pub(crate) fn zstd_copy_decode(_src: &[u8], _dst: &mut [u8]) -> io::Result<()> {
+    Err(io::Error::other("zstd support is not compiled in"))
+}
+
+impl io::Read for ZstdReader<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        #[cfg(feature = "binlog")]
+        return self.0.read(buf);
+        #[cfg(not(feature = "binlog"))]
+        match self.0 {}
+    }
+}
+
+impl io::BufRead for ZstdReader<'_> {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        #[cfg(feature = "binlog")]
+        return self.0.fill_buf();
+        #[cfg(not(feature = "binlog"))]
+        match self.0 {}
+    }
+
+    fn consume(&mut self, amt: usize) {
+        #[cfg(feature = "binlog")]
+        return self.0.consume(amt);
+        #[cfg(not(feature = "binlog"))]
+        match self.0 {}
+    }
+}
