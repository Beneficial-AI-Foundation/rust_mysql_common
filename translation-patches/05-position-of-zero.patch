+/// `s.iter().position(|x| *x == 0)`, written as a loop.
+pub(crate) fn position_of_zero(s: &[u8]) -> Option<usize> {
+    let mut i = 0;
+    while i < s.len() {
+        if s[i] == 0 {
+            return Some(i);
+        }
+        i += 1;
+    }
+    None
+}
