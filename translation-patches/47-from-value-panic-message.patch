Translation patch: `FromValue::from_value`

Change: `panic!("Could not retrieve `{}`: {e}", type_name::<Self>())` becomes `panic!("Could not retrieve a value of the requested type")` (and the `type_name` import is dropped).
Why: Formatting `{e}` uses thiserror's `Display for FromValueError`, hence `Debug for Value`, which reaches `str::pattern` (Aeneas: "Unimplemented"); formatting is out of scope.
Behaviour: Identical except for the text of the panic message: it panics in exactly the same cases.

diff --git a/src/value/convert/mod.rs b/src/value/convert/mod.rs
index 9d4c7d5..11997e0 100644
--- a/src/value/convert/mod.rs
+++ b/src/value/convert/mod.rs
@@ -9,7 +9,6 @@
 use num_traits::ToPrimitive;
 
 use std::{
-    any::type_name,
     borrow::Cow,
     convert::{TryFrom, TryInto},
     rc::Rc,
@@ -100,7 +99,7 @@ pub trait FromValue: Sized {
     fn from_value(v: Value) -> Self {
         match Self::from_value_opt(v) {
             Ok(this) => this,
-            Err(e) => panic!("Could not retrieve `{}`: {e}", type_name::<Self>(),),
+            Err(_) => panic!("Could not retrieve a value of the requested type"),
         }
     }
 
