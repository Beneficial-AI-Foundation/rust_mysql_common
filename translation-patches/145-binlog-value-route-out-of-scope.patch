+/// `Decimal::read_bin(input, precision, scale, false)` rendered with `to_string().into_bytes()`
+/// (translation helper for `BinlogValue::deserialize`; this module is opaque in the translation).
+pub(crate) fn read_bin_to_string_bytes(
+    input: &mut crate::io::ParseBuf<'_>,
+    precision: usize,
+    scale: usize,
+) -> io::Result<Vec<u8>> {
+    let dec = Decimal::read_bin(input, precision, scale, false)?;
+    Ok(dec.to_string().into_bytes())
+}
