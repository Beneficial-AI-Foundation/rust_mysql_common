+
+/// Parses `JsonDiff`s until `buf` is empty (translation helper for
+/// `BinlogValue::deserialize`; this module is opaque in the translation).
+pub(crate) fn parse_json_diffs(mut buf: ParseBuf<'_>) -> io::Result<Vec<JsonDiff<'_>>> {
+    let mut diffs = Vec::new();
+    while !buf.is_empty() {
+        diffs.push(buf.parse(())?);
+    }
+    Ok(diffs)
+}
