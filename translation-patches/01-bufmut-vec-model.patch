+/// The methods of `bytes::BufMut` that the crate uses, implemented for `Vec<u8>` with the bodies
+/// they have in `bytes` 1.x (`put_slice` is `extend_from_slice`, the others call `put_slice`).
+pub trait BufMut {
+    fn put_slice(&mut self, src: &[u8]);
+    fn put_u8(&mut self, n: u8);
+    fn put_i8(&mut self, n: i8);
+    fn put_u16_le(&mut self, n: u16);
+    fn put_i16_le(&mut self, n: i16);
+    fn put_u32_le(&mut self, n: u32);
+    fn put_i32_le(&mut self, n: i32);
+    fn put_u64_le(&mut self, n: u64);
+    fn put_i64_le(&mut self, n: i64);
+    fn put_uint_le(&mut self, n: u64, nbytes: usize);
+    fn put_int_le(&mut self, n: i64, nbytes: usize);
+    fn put_f32_le(&mut self, n: f32);
+    fn put_f64_le(&mut self, n: f64);
+}
+
+impl BufMut for Vec<u8> {
+    fn put_slice(&mut self, src: &[u8]) {
+        self.extend_from_slice(src);
+    }
+
+    fn put_u8(&mut self, n: u8) {
+        let src = [n];
+        self.put_slice(&src);
+    }
+
+    fn put_i8(&mut self, n: i8) {
+        let src = [n as u8];
+        self.put_slice(&src)
+    }
+
+    fn put_u16_le(&mut self, n: u16) {
+        self.put_slice(&n.to_le_bytes())
+    }
+
+    fn put_i16_le(&mut self, n: i16) {
+        self.put_slice(&n.to_le_bytes())
+    }
+
+    fn put_u32_le(&mut self, n: u32) {
+        self.put_slice(&n.to_le_bytes())
+    }
+
+    fn put_i32_le(&mut self, n: i32) {
+        self.put_slice(&n.to_le_bytes())
+    }
+
+    fn put_u64_le(&mut self, n: u64) {
+        self.put_slice(&n.to_le_bytes())
+    }
+
+    fn put_i64_le(&mut self, n: i64) {
+        self.put_slice(&n.to_le_bytes())
+    }
+
+    /// Panics if `nbytes > 8`.
+    fn put_uint_le(&mut self, n: u64, nbytes: usize) {
+        let slice = n.to_le_bytes();
+        self.put_slice(&slice[..nbytes]);
+    }
+
+    /// Panics if `nbytes > 8`.
+    fn put_int_le(&mut self, n: i64, nbytes: usize) {
+        let slice = n.to_le_bytes();
+        self.put_slice(&slice[..nbytes]);
+    }
+
+    fn put_f32_le(&mut self, n: f32) {
+        self.put_u32_le(n.to_bits());
+    }
+
+    fn put_f64_le(&mut self, n: f64) {
+        self.put_u64_le(n.to_bits());
+    }
+}
+
