+/// The loop `for _ in 0..count { .. }` of `StatusVar::get_value` for `UpdatedDbNames`: each
+/// iteration pushes the bytes of `read` before its first `0` (failing if there is none) and
+/// continues from that `0` (which is not skipped).
+fn updated_db_names<'a>(
+    read: &'a [u8],
+    count: usize,
+    names: &mut Vec<RawBytes<'a, NullBytes>>,
+) -> Option<()> {
+    if count == 0 {
+        return Some(());
+    }
+    let mut index = 0;
+    while index < read.len() && read[index] != 0 {
+        index += 1;
+    }
+    if index == read.len() {
+        return None;
+    }
+    names.push(RawBytes::new(&read[..index]));
+    updated_db_names(&read[index..], count - 1, names)
+}
