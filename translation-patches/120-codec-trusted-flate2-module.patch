+//! Translation helpers: the trust boundary of the compressed codec.
+//!
+//! Every operation of `flate2` (and the one `std` operation without an Aeneas model) that the
+//! compressed codec uses goes through exactly one function of this module. The module is
+//! `opaque` in Cargo.toml: these functions are not translated, and each has a Lean model or
+//! axiom in `lean/MysqlCommon/FunsExternal.lean`.
+
+#![allow(dead_code)]
+
+use std::io;
+
+use flate2::{Compress, Compression, Decompress, FlushCompress, FlushDecompress, Status};
+
+/// `Compression::none()`.
+pub(crate) fn compression_none() -> Compression {
+    Compression::none()
+}
+
+/// `a == b` (the derived `PartialEq for Compression`).
+pub(crate) fn compression_eq(a: Compression, b: Compression) -> bool {
+    a == b
+}
+
+/// `Compress::new(level, true)`: a zlib deflate stream.
+pub(crate) fn compress_new(level: Compression) -> Compress {
+    Compress::new(level, true)
+}
+
+/// `Decompress::new(true)`: a zlib inflate stream.
+pub(crate) fn decompress_new() -> Decompress {
+    Decompress::new(true)
+}
+
+/// The body of upstream `deflate_into`, writing into a fresh buffer instead of the spare
+/// capacity of the destination: resets `deflater`, deflates `chunk` with `FlushCompress::Finish`
+/// into a buffer of `chunk.len()` bytes, and returns the deflated bytes if the stream ended and
+/// they are fewer than `chunk.len()`, and `None` otherwise.
+pub(crate) fn deflate(deflater: &mut Compress, chunk: &[u8]) -> io::Result<Option<Vec<u8>>> {
+    deflater.reset();
+    let mut out = vec![0_u8; chunk.len()];
+    let status = deflater
+        .compress(chunk, &mut out, FlushCompress::Finish)
+        .map_err(io::Error::other)?;
+
+    let compressed_len = deflater.total_out() as usize;
+    if status == Status::StreamEnd && compressed_len < chunk.len() {
+        out.truncate(compressed_len);
+        Ok(Some(out))
+    } else {
+        Ok(None)
+    }
+}
+
+/// The body of upstream `inflate_into`, writing into a fresh buffer instead of the spare
+/// capacity of the destination: resets `inflater`, inflates `compressed` with
+/// `FlushDecompress::Finish` into a buffer of `plain_len` bytes, and returns that buffer if the
+/// stream ended having produced exactly `plain_len` bytes, and an `InvalidData` error otherwise.
+pub(crate) fn inflate(
+    inflater: &mut Decompress,
+    compressed: &[u8],
+    plain_len: usize,
+) -> io::Result<Vec<u8>> {
+    inflater.reset(true);
+    let mut out = vec![0_u8; plain_len];
+    let status = inflater
+        .decompress(compressed, &mut out, FlushDecompress::Finish)
+        .map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))?;
+
+    if status != Status::StreamEnd || inflater.total_out() != plain_len as u64 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "compressed packet does not inflate to its declared length",
+        ));
+    }
+    Ok(out)
+}
+
+/// `Vec::capacity`.
+pub(crate) fn vec_capacity(v: &Vec<u8>) -> usize {
+    v.capacity()
+}
