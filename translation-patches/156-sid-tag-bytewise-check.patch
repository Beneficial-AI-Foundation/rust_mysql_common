+
+// `Tag::validate(s).is_ok()` for a `&str` `s` with bytes `b`: 1 to `Tag::MAX_LEN` bytes, the
+// first an ASCII lowercase letter or `_`, the others ASCII lowercase letters, digits or `_`.
+fn tag_bytes_valid(b: &[u8]) -> bool {
+    if b.is_empty() || b.len() > Tag::MAX_LEN {
+        false
+    } else if (b[0] >= b'a' && b[0] <= b'z') || b[0] == b'_' {
+        tag_bytes_valid_from(b, 1)
+    } else {
+        false
+    }
+}
+
+// The bytes of `b` from index `i` on are ASCII lowercase letters, digits or `_` (recursive).
+fn tag_bytes_valid_from(b: &[u8], i: usize) -> bool {
+    if i < b.len() {
+        let c = b[i];
+        if (c >= b'a' && c <= b'z') || (c >= b'0' && c <= b'9') || c == b'_' {
+            tag_bytes_valid_from(b, i + 1)
+        } else {
+            false
         }
+    } else {
+        true
     }
 }
 
