+/// The error of `Sid::deserialize_tagged` for a tag that is valid UTF-8 but not a valid `Tag`:
+/// the `InvalidTag` of `Tag::new`, as an `InvalidData` `io::Error`.
+pub(crate) fn sid_tag_invalid_error(tag_str: &str) -> std::io::Error {
+    match crate::packets::Tag::new(tag_str.to_owned()) {
+        Err(e) => crate::misc::io_error_from(std::io::ErrorKind::InvalidData, e),
+        Ok(_) => unreachable!("sid_tag_invalid_error: the tag is valid"),
+    }
+}
