+
+/// `attrs.insert(key, value);` (the previous value, if any, is dropped).
+pub(crate) fn connect_attrs_insert<'a>(
+    attrs: &mut ConnectAttrs<'a>,
+    key: crate::misc::raw::RawBytes<'a, crate::misc::raw::bytes::LenEnc>,
+    value: crate::misc::raw::RawBytes<'a, crate::misc::raw::bytes::LenEnc>,
