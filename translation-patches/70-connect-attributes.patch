+    attrs
+        .into_iter()
+        .map(|(k, v)| {
+            (
+                crate::misc::raw::RawBytes::new(k.into_bytes()),
+                crate::misc::raw::RawBytes::new(v.into_bytes()),
+            )
+        })
+        .collect()
