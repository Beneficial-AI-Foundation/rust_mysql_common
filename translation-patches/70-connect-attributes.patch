+/// `attrs.iter().map(|(k, v)| (k.as_bytes(), v.as_bytes())).collect()`: the entries, in the
+/// map's iteration order.
+pub(crate) fn connect_attrs_entries<'b>(attrs: &'b ConnectAttrs<'_>) -> Vec<(&'b [u8], &'b [u8])> {
+    attrs
