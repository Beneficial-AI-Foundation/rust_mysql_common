+/// `attrs.iter().map(|(k, v)| (k.as_str().into_owned(), v.as_str().into_owned())).collect()`.
+pub(crate) fn connect_attrs_to_strings(
+    attrs: &ConnectAttrs<'_>,
+) -> std::collections::HashMap<String, String> {
+    attrs
+        .iter()
+        .map(|(k, v)| (k.as_str().into_owned(), v.as_str().into_owned()))
