+/// `len` values of `T` parsed from `buf`, as an owned sequence.
+fn parse_items<'de, T>(len: usize, buf: &mut ParseBuf<'de>) -> io::Result<Cow<'de, [T]>>
+where
+    T: Clone,
+    T: MyDeserialize<'de, Ctx = ()>,
+{
+    let mut seq = Vec::with_capacity(len);
+    for _ in 0..len {
+        seq.push(buf.parse(())?);
+    }
+    Ok(Cow::Owned(seq))
+}
