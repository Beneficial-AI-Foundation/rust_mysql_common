+/// Sorts `v` in ascending order (insertion sort).
+fn sort_indexes(v: &mut [usize]) {
+    let mut i = 1;
+    while i < v.len() {
+        let mut j = i;
+        while j > 0 && v[j - 1] > v[j] {
+            v.swap(j - 1, j);
+            j -= 1;
+        }
+        i += 1;
+    }
+}
