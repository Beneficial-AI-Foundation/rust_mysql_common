+use crate::{io::ParseBuf, value::Value};
+
+/// The error of `byteorder::ReadBytesExt::read_*` on a `ParseBuf` that is too short: the reader
+/// consumed what was left (`Read::read_exact` reads until the buffer is empty) and failed with
+/// `read_exact`'s error.
+fn read_eof(input: &mut ParseBuf<'_>) -> io::Error {
+    input.0 = &input.0[input.0.len()..];
+    crate::binlog::trusted::read_exact_eof()
+}
+
+/// `input.read_u8()` (byteorder).
+fn read_u8(input: &mut ParseBuf<'_>) -> io::Result<u8> {
+    match input.checked_eat_u8() {
+        Some(x) => Ok(x),
+        None => Err(read_eof(input)),
+    }
+}
+
