+/// The error of `Read::read_exact` on a reader that ends early (std's `READ_EXACT_EOF`, of kind
+/// `UnexpectedEof`), obtained from `read_exact` on an empty slice.
+pub(crate) fn read_exact_eof() -> io::Error {
+    use std::io::Read;
+    let mut empty: &[u8] = &[];
+    match empty.read_exact(&mut [0_u8]) {
+        Ok(()) => unreachable!(),
+        Err(e) => e,
+    }
+}
